{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genes-ts.dev/schemas/development-session-event-v1.json",
  "title": "Genes tooling development-session event v1",
  "$ref": "#/$defs/developmentEvent",
  "$defs": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "updated", "deleted"],
      "properties": {
        "created": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/portablePath" }
        },
        "updated": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/portablePath" }
        },
        "deleted": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/portablePath" }
        }
      }
    },
    "acceptedGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "revision",
        "acceptedAt",
        "manifestDigest",
        "compilerMode",
        "files",
        "entryChanged"
      ],
      "properties": {
        "generation": { "$ref": "#/$defs/positiveInteger" },
        "revision": { "$ref": "#/$defs/positiveInteger" },
        "acceptedAt": { "type": "number", "minimum": 0 },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "compilerMode": { "enum": ["connected", "direct"] },
        "files": { "$ref": "#/$defs/fileDelta" },
        "entryChanged": { "type": "boolean" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "revision",
        "recoverable",
        "diagnostic",
        "retained"
      ],
      "properties": {
        "phase": {
          "enum": [
            "recovery",
            "inventory",
            "watch",
            "compile",
            "validate",
            "publish",
            "shutdown"
          ]
        },
        "revision": {
          "oneOf": [
            { "$ref": "#/$defs/positiveInteger" },
            { "type": "null" }
          ]
        },
        "recoverable": { "type": "boolean" },
        "diagnostic": {},
        "retained": {
          "oneOf": [
            { "$ref": "#/$defs/acceptedGeneration" },
            { "type": "null" }
          ]
        }
      }
    },
    "state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "opening" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "retained"],
          "properties": {
            "kind": { "const": "building" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "retained": {
              "oneOf": [
                { "$ref": "#/$defs/acceptedGeneration" },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failure"],
          "properties": {
            "kind": { "const": "blocked" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "accepted"],
          "properties": {
            "kind": { "const": "ready" },
            "accepted": { "$ref": "#/$defs/acceptedGeneration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "accepted", "failure"],
          "properties": {
            "kind": { "const": "degraded" },
            "accepted": { "$ref": "#/$defs/acceptedGeneration" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "retained"],
          "properties": {
            "kind": { "enum": ["closing", "closed"] },
            "retained": {
              "oneOf": [
                { "$ref": "#/$defs/acceptedGeneration" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "compilerLifecycle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "fallback" },
            "reason": {
              "enum": [
                "live-foreign-lease",
                "untrusted-lease",
                "lease-race",
                "lease-write-failed",
                "port-reservation-failed",
                "start-failed",
                "readiness-timeout",
                "startup-exit",
                "server-unresponsive",
                "shutdown-timeout"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "endpoint"],
          "properties": {
            "kind": { "const": "started" },
            "endpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host", "port", "argument"],
              "properties": {
                "host": { "const": "127.0.0.1" },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "argument": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pid"],
          "properties": {
            "kind": { "enum": ["unexpected-exit", "shutdown-timeout"] },
            "pid": { "$ref": "#/$defs/positiveInteger" }
          }
        }
      ]
    },
    "developmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "lastSequence",
        "newestRevision",
        "accepted",
        "lastCompilerEvent"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "lastSequence": {
          "type": "integer",
          "minimum": 0
        },
        "newestRevision": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "oneOf": [
            { "$ref": "#/$defs/acceptedGeneration" },
            { "type": "null" }
          ]
        },
        "lastCompilerEvent": {
          "oneOf": [
            { "$ref": "#/$defs/compilerLifecycle" },
            { "type": "null" }
          ]
        }
      }
    },
    "eventBody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "state"],
          "properties": {
            "kind": { "const": "state" },
            "state": { "$ref": "#/$defs/state" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "paths"],
          "properties": {
            "kind": { "const": "inputs-changed" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/portablePath" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision"],
          "properties": {
            "kind": { "const": "build-started" },
            "revision": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "manifestDigest"],
          "properties": {
            "kind": { "const": "candidate-generated" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "manifestDigest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "newestRevision"],
          "properties": {
            "kind": { "const": "candidate-superseded" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "newestRevision": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "accepted"],
          "properties": {
            "kind": { "const": "generation-accepted" },
            "accepted": { "$ref": "#/$defs/acceptedGeneration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failure"],
          "properties": {
            "kind": { "const": "failed" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "event"],
          "properties": {
            "kind": { "const": "compiler-lifecycle" },
            "event": { "$ref": "#/$defs/compilerLifecycle" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "closed" } }
        }
      ]
    },
    "developmentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "sequence", "at", "event"],
      "properties": {
        "protocol": { "const": "genes.tooling.development-session-event" },
        "version": { "const": 1 },
        "sequence": { "$ref": "#/$defs/positiveInteger" },
        "at": { "type": "number", "minimum": 0 },
        "event": { "$ref": "#/$defs/eventBody" }
      }
    }
  }
}
