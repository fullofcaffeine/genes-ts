{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genes-ts.dev/schemas/development-session-event-v1.json",
  "title": "Genes tooling development-session event v1",
  "$ref": "#/$defs/developmentEvent",
  "$defs": {
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "publishedPath": {
      "type": "string",
      "description": "A slash-normalized path inside the public project output.",
      "minLength": 1,
      "pattern": "^(?!@external(?:/|$))(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
    },
    "inputPath": {
      "type": "string",
      "description": "A slash-normalized project input or private logical external-input path.",
      "minLength": 1,
      "pattern": "^(?:(?!@external(?:/|$))(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*|@external/(?:0|[1-9][0-9]*)(?:/(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+)*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "updated", "deleted"],
      "properties": {
        "created": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/publishedPath" }
        },
        "updated": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/publishedPath" }
        },
        "deleted": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/publishedPath" }
        }
      }
    },
    "acceptedGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "revision",
        "acceptedAt",
        "manifestDigest",
        "compilerMode",
        "files",
        "entryChanged"
      ],
      "properties": {
        "generation": { "$ref": "#/$defs/positiveInteger" },
        "revision": { "$ref": "#/$defs/positiveInteger" },
        "acceptedAt": { "type": "number", "minimum": 0 },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "compilerMode": { "enum": ["connected", "direct", "external"] },
        "files": { "$ref": "#/$defs/fileDelta" },
        "entryChanged": { "type": "boolean" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "revision",
        "recoverable",
        "diagnostic",
        "retained"
      ],
      "properties": {
        "phase": {
          "enum": [
            "recovery",
            "inventory",
            "watch",
            "compile",
            "validate",
            "publish",
            "shutdown"
          ]
        },
        "revision": {
          "oneOf": [
            { "$ref": "#/$defs/positiveInteger" },
            { "type": "null" }
          ]
        },
        "recoverable": { "type": "boolean" },
        "diagnostic": {},
        "retained": {
          "oneOf": [
            { "$ref": "#/$defs/acceptedGeneration" },
            { "type": "null" }
          ]
        }
      }
    },
    "state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "opening" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "retained"],
          "properties": {
            "kind": { "const": "building" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "retained": {
              "oneOf": [
                { "$ref": "#/$defs/acceptedGeneration" },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failure"],
          "properties": {
            "kind": { "const": "blocked" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "accepted"],
          "properties": {
            "kind": { "const": "ready" },
            "accepted": { "$ref": "#/$defs/acceptedGeneration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "accepted", "failure"],
          "properties": {
            "kind": { "const": "degraded" },
            "accepted": { "$ref": "#/$defs/acceptedGeneration" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "retained"],
          "properties": {
            "kind": { "enum": ["closing", "closed"] },
            "retained": {
              "oneOf": [
                { "$ref": "#/$defs/acceptedGeneration" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "outputCheck": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check", "revision", "result", "modules"],
          "properties": {
            "check": { "const": "replay-audit" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "result": { "const": "differs" },
            "modules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "code": { "const": "AUDIT_REPEATED" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check", "revision", "generation", "result", "paths"],
          "properties": {
            "check": { "const": "cold-build" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "generation": { "$ref": "#/$defs/positiveInteger" },
            "result": { "enum": ["equal", "differs", "cancelled", "failed"] },
            "paths": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/publishedPath" }
            },
            "code": {
              "enum": [
                "COLD_BUILD_FAILED",
                "COLD_DIFFERS_AFTER_REPAIR",
                "PREPARED_FILES_CHANGED",
                "COLD_BUILD_UNSUPPORTED",
                "COLD_CHECK_ERROR"
              ]
            },
            "message": { "type": "string", "maxLength": 2000 }
          }
        }
      ]
    },
    "compilerLifecycle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "fallback" },
            "reason": {
              "enum": [
                "live-foreign-lease",
                "untrusted-lease",
                "lease-race",
                "lease-write-failed",
                "port-reservation-failed",
                "start-failed",
                "readiness-timeout",
                "startup-exit",
                "server-unresponsive",
                "shutdown-timeout"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "endpoint"],
          "properties": {
            "kind": { "const": "started" },
            "endpoint": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["host", "port", "argument"],
                  "properties": {
                    "host": { "const": "127.0.0.1" },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "argument": { "type": "string", "minLength": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["transport", "argument"],
                  "properties": {
                    "transport": { "const": "stdio" },
                    "argument": { "const": "stdio" }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pid"],
          "properties": {
            "kind": { "enum": ["unexpected-exit", "shutdown-timeout"] },
            "pid": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason", "firstBytes"],
          "properties": {
            "kind": { "const": "transport-failed" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "firstBytes": { "type": "string", "maxLength": 256 }
          }
        }
      ]
    },
    "moduleName": {
      "type": "string",
      "description": "A Haxe module path, for example ui.Button.",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "previewFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": { "$ref": "#/$defs/publishedPath" },
        "sha256": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "modulePreviewSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["differences", "stoppedModules"],
      "properties": {
        "differences": { "type": "integer", "minimum": 0 },
        "stoppedModules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/moduleName" }
        }
      }
    },
    "developmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "lastSequence",
        "newestRevision",
        "accepted",
        "lastCompilerEvent"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "lastSequence": {
          "type": "integer",
          "minimum": 0
        },
        "newestRevision": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "oneOf": [
            { "$ref": "#/$defs/acceptedGeneration" },
            { "type": "null" }
          ]
        },
        "lastCompilerEvent": {
          "oneOf": [
            { "$ref": "#/$defs/compilerLifecycle" },
            { "type": "null" }
          ]
        },
        "modulePreview": { "$ref": "#/$defs/modulePreviewSnapshot" }
      }
    },
    "eventBody": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "state"],
          "properties": {
            "kind": { "const": "state" },
            "state": { "$ref": "#/$defs/state" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "paths"],
          "properties": {
            "kind": { "const": "inputs-changed" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/inputPath" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision"],
          "properties": {
            "kind": { "const": "build-started" },
            "revision": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "manifestDigest"],
          "properties": {
            "kind": { "const": "candidate-generated" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "manifestDigest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "newestRevision"],
          "properties": {
            "kind": { "const": "candidate-superseded" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "newestRevision": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "accepted"],
          "properties": {
            "kind": { "const": "generation-accepted" },
            "accepted": { "$ref": "#/$defs/acceptedGeneration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failure"],
          "properties": {
            "kind": { "const": "failed" },
            "failure": { "$ref": "#/$defs/failure" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "event"],
          "properties": {
            "kind": { "const": "compiler-lifecycle" },
            "event": { "$ref": "#/$defs/compilerLifecycle" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outputCheck"],
          "properties": {
            "kind": { "const": "output-check" },
            "outputCheck": { "$ref": "#/$defs/outputCheck" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "module", "files"],
          "properties": {
            "kind": { "const": "preview-generated" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "module": { "$ref": "#/$defs/moduleName" },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/previewFile" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "module", "source", "code"],
          "properties": {
            "kind": { "const": "preview-refused" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "module": {
              "oneOf": [{ "$ref": "#/$defs/moduleName" }, { "type": "null" }]
            },
            "source": { "enum": ["genes", "session"] },
            "code": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "module", "generation", "paths"],
          "properties": {
            "kind": { "const": "preview-confirmed" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "module": { "$ref": "#/$defs/moduleName" },
            "generation": { "$ref": "#/$defs/positiveInteger" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/publishedPath" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "module", "generation", "paths", "cause"],
          "properties": {
            "kind": { "const": "preview-corrected" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "module": { "$ref": "#/$defs/moduleName" },
            "generation": { "$ref": "#/$defs/positiveInteger" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/publishedPath" }
            },
            "cause": { "enum": ["differs", "newer-revision"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision", "request", "module", "process"],
          "properties": {
            "kind": { "const": "request-measured" },
            "revision": { "$ref": "#/$defs/positiveInteger" },
            "request": { "enum": ["program", "module"] },
            "module": {
              "oneOf": [{ "$ref": "#/$defs/moduleName" }, { "type": "null" }]
            },
            "process": {
              "type": "object",
              "additionalProperties": false,
              "required": ["instructions", "cpuMs", "unavailable"],
              "properties": {
                "instructions": {
                  "oneOf": [{ "type": "integer" }, { "type": "null" }]
                },
                "cpuMs": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
                "unavailable": {
                  "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "closed" } }
        }
      ]
    },
    "developmentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "sequence", "at", "event"],
      "properties": {
        "protocol": { "const": "genes.tooling.development-session-event" },
        "version": { "const": 1 },
        "sequence": { "$ref": "#/$defs/positiveInteger" },
        "at": { "type": "number", "minimum": 0 },
        "event": { "$ref": "#/$defs/eventBody" }
      }
    }
  }
}
