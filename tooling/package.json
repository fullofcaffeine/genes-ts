{
  "name": "@genes-ts/tooling",
  "version": "0.5.0",
  "description": "Framework-neutral host tooling for Haxe-to-JavaScript and Haxe-to-TypeScript projects.",
  "type": "module",
  "bin": {
    "genes": "./dist/cli.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullofcaffeine/genes-ts.git",
    "directory": "tooling"
  },
  "homepage": "https://github.com/fullofcaffeine/genes-ts/tree/main/tooling",
  "bugs": {
    "url": "https://github.com/fullofcaffeine/genes-ts/issues"
  },
  "engines": {
    "node": "^26.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents/index.js"
    },
    "./agent-guidance/v1/AGENTS.md": "./agent-guidance/v1/AGENTS.md",
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./css-modules": {
      "types": "./dist/css-modules/index.d.ts",
      "import": "./dist/css-modules/index.js"
    },
    "./css-modules/postcss-modules": {
      "types": "./dist/css-modules/postcss-modules-provider.d.ts",
      "import": "./dist/css-modules/postcss-modules-provider.js"
    },
    "./css-modules/typescript-declaration": {
      "types": "./dist/css-modules/typescript-declaration-provider.d.ts",
      "import": "./dist/css-modules/typescript-declaration-provider.js"
    },
    "./css-modules/v1/exports.schema.json": "./css-modules/v1/exports.schema.json",
    "./development-session/v1/protocol.schema.json": "./development-session/v1/protocol.schema.json",
    "./development-session/v1/vectors.schema.json": "./development-session/v1/vectors.schema.json",
    "./development-session/v1/vectors.json": "./development-session/v1/vectors.json",
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "import": "./dist/loop/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    },
    "./hxml": {
      "types": "./dist/hxml/index.d.ts",
      "import": "./dist/hxml/index.js"
    },
    "./lix": {
      "types": "./dist/lix/index.d.ts",
      "import": "./dist/lix/index.js"
    },
    "./haxe-server": {
      "types": "./dist/haxe-server/index.d.ts",
      "import": "./dist/haxe-server/index.js"
    },
    "./haxe-wait-server/v1/vectors.schema.json": "./haxe-wait-server/v1/vectors.schema.json",
    "./haxe-wait-server/v1/vectors.json": "./haxe-wait-server/v1/vectors.json",
    "./watch": {
      "types": "./dist/watch/index.d.ts",
      "import": "./dist/watch/index.js"
    },
    "./artifact-transactions/v1/protocol.schema.json": "./artifact-transactions/v1/protocol.schema.json",
    "./artifact-transactions/v1/vectors.schema.json": "./artifact-transactions/v1/vectors.schema.json",
    "./artifact-transactions/v1/vectors.json": "./artifact-transactions/v1/vectors.json",
    "./watch-orchestration/v1/vectors.schema.json": "./watch-orchestration/v1/vectors.schema.json",
    "./watch-orchestration/v1/vectors.json": "./watch-orchestration/v1/vectors.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "agent-guidance/v1/AGENTS.md",
    "dist/cli.js",
    "dist/cli.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/index.js",
    "dist/index.js.map",
    "dist/agents/**/*.d.ts",
    "dist/agents/**/*.d.ts.map",
    "dist/agents/**/*.js",
    "dist/agents/**/*.js.map",
    "dist/artifacts/**/*.d.ts",
    "dist/artifacts/**/*.d.ts.map",
    "dist/artifacts/**/*.js",
    "dist/artifacts/**/*.js.map",
    "dist/css-modules/**/*.d.ts",
    "dist/css-modules/**/*.d.ts.map",
    "dist/css-modules/**/*.js",
    "dist/css-modules/**/*.js.map",
    "css-modules/v1/adapters/**/*.cjs",
    "css-modules/v1/adapters/**/package.json",
    "css-modules/v1/exports.schema.json",
    "css-modules/v1/README.md",
    "dist/loop/**/*.d.ts",
    "dist/loop/**/*.d.ts.map",
    "dist/loop/**/*.js",
    "dist/loop/**/*.js.map",
    "dist/hxml/**/*.d.ts",
    "dist/hxml/**/*.d.ts.map",
    "dist/hxml/**/*.js",
    "dist/hxml/**/*.js.map",
    "dist/lix/**/*.d.ts",
    "dist/lix/**/*.d.ts.map",
    "dist/lix/**/*.js",
    "dist/lix/**/*.js.map",
    "dist/haxe-server/**/*.d.ts",
    "dist/haxe-server/**/*.d.ts.map",
    "dist/haxe-server/**/*.js",
    "dist/haxe-server/**/*.js.map",
    "dist/session/**/*.d.ts",
    "dist/session/**/*.d.ts.map",
    "dist/session/**/*.js",
    "dist/session/**/*.js.map",
    "development-session/v1/*.json",
    "development-session/v1/README.md",
    "haxe-wait-server/v1/*.json",
    "haxe-wait-server/v1/README.md",
    "dist/watch/**/*.d.ts",
    "dist/watch/**/*.d.ts.map",
    "dist/watch/**/*.js",
    "dist/watch/**/*.js.map",
    "artifact-transactions/v1/*.json",
    "artifact-transactions/v1/README.md",
    "watch-orchestration/v1/*.json",
    "watch-orchestration/v1/README.md",
    "README.md"
  ],
  "scripts": {
    "build": "npm exec --no -- tsc6 -p tsconfig.json",
    "prepare": "npm run build",
    "test": "yarn build && node dist/agents-test.js && node dist/test.js && node dist/vector-test.js && node dist/loop-test.js && node dist/hxml-test.js && node dist/lix-test.js && node dist/css-modules-test.js && node dist/installed-package-closure-test.js && node dist/processor-execution-admission-test.js && node dist/css-module-providers-test.js && node dist/watch-test.js && node dist/watch-vector-test.js && node dist/haxe-server-test.js && node dist/haxe-server-vector-test.js && node dist/haxe-launch-test.js && node dist/session-vector-test.js && node dist/session-runtime-vector-test.js && node dist/session-test.js && node dist/session-integration-test.js",
    "pack:check": "yarn build && node ../scripts/dist/test-tooling-package.js"
  },
  "peerDependencies": {
    "postcss": "8.5.25",
    "postcss-modules": "9.0.1",
    "postcss-selector-parser": "7.1.4",
    "typescript": "6.0.3"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "postcss-modules": {
      "optional": true
    },
    "postcss-selector-parser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "typescript-build": "npm:@typescript/typescript6@6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
