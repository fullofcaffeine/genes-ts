{
  "name": "@genes-ts/tooling",
  "version": "0.3.0",
  "description": "Framework-neutral host tooling for Haxe-to-JavaScript and Haxe-to-TypeScript projects.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fullofcaffeine/genes-ts.git",
    "directory": "tooling"
  },
  "homepage": "https://github.com/fullofcaffeine/genes-ts/tree/main/tooling",
  "bugs": {
    "url": "https://github.com/fullofcaffeine/genes-ts/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./css-modules": {
      "types": "./dist/css-modules/index.d.ts",
      "import": "./dist/css-modules/index.js"
    },
    "./css-modules/v1/exports.schema.json": "./css-modules/v1/exports.schema.json",
    "./development-session/v1/protocol.schema.json": "./development-session/v1/protocol.schema.json",
    "./development-session/v1/vectors.schema.json": "./development-session/v1/vectors.schema.json",
    "./development-session/v1/vectors.json": "./development-session/v1/vectors.json",
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "import": "./dist/loop/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    },
    "./hxml": {
      "types": "./dist/hxml/index.d.ts",
      "import": "./dist/hxml/index.js"
    },
    "./lix": {
      "types": "./dist/lix/index.d.ts",
      "import": "./dist/lix/index.js"
    },
    "./haxe-server": {
      "types": "./dist/haxe-server/index.d.ts",
      "import": "./dist/haxe-server/index.js"
    },
    "./haxe-wait-server/v1/vectors.schema.json": "./haxe-wait-server/v1/vectors.schema.json",
    "./haxe-wait-server/v1/vectors.json": "./haxe-wait-server/v1/vectors.json",
    "./watch": {
      "types": "./dist/watch/index.d.ts",
      "import": "./dist/watch/index.js"
    },
    "./artifact-transactions/v1/protocol.schema.json": "./artifact-transactions/v1/protocol.schema.json",
    "./artifact-transactions/v1/vectors.schema.json": "./artifact-transactions/v1/vectors.schema.json",
    "./artifact-transactions/v1/vectors.json": "./artifact-transactions/v1/vectors.json",
    "./watch-orchestration/v1/vectors.schema.json": "./watch-orchestration/v1/vectors.schema.json",
    "./watch-orchestration/v1/vectors.json": "./watch-orchestration/v1/vectors.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/index.js",
    "dist/index.js.map",
    "dist/artifacts/**/*.d.ts",
    "dist/artifacts/**/*.d.ts.map",
    "dist/artifacts/**/*.js",
    "dist/artifacts/**/*.js.map",
    "dist/css-modules/**/*.d.ts",
    "dist/css-modules/**/*.d.ts.map",
    "dist/css-modules/**/*.js",
    "dist/css-modules/**/*.js.map",
    "css-modules/v1/exports.schema.json",
    "css-modules/v1/README.md",
    "dist/loop/**/*.d.ts",
    "dist/loop/**/*.d.ts.map",
    "dist/loop/**/*.js",
    "dist/loop/**/*.js.map",
    "dist/hxml/**/*.d.ts",
    "dist/hxml/**/*.d.ts.map",
    "dist/hxml/**/*.js",
    "dist/hxml/**/*.js.map",
    "dist/lix/**/*.d.ts",
    "dist/lix/**/*.d.ts.map",
    "dist/lix/**/*.js",
    "dist/lix/**/*.js.map",
    "dist/haxe-server/**/*.d.ts",
    "dist/haxe-server/**/*.d.ts.map",
    "dist/haxe-server/**/*.js",
    "dist/haxe-server/**/*.js.map",
    "dist/session/**/*.d.ts",
    "dist/session/**/*.d.ts.map",
    "dist/session/**/*.js",
    "dist/session/**/*.js.map",
    "development-session/v1/*.json",
    "development-session/v1/README.md",
    "haxe-wait-server/v1/*.json",
    "haxe-wait-server/v1/README.md",
    "dist/watch/**/*.d.ts",
    "dist/watch/**/*.d.ts.map",
    "dist/watch/**/*.js",
    "dist/watch/**/*.js.map",
    "artifact-transactions/v1/*.json",
    "artifact-transactions/v1/README.md",
    "watch-orchestration/v1/*.json",
    "watch-orchestration/v1/README.md",
    "README.md"
  ],
  "scripts": {
    "build": "npm exec --no -- tsc6 -p tsconfig.json",
    "prepare": "npm run build",
    "test": "yarn build && node dist/test.js && node dist/vector-test.js && node dist/loop-test.js && node dist/hxml-test.js && node dist/lix-test.js && node dist/css-modules-test.js && node dist/watch-test.js && node dist/watch-vector-test.js && node dist/haxe-server-test.js && node dist/haxe-server-vector-test.js && node dist/session-vector-test.js && node dist/session-runtime-vector-test.js && node dist/session-test.js && node dist/session-integration-test.js",
    "pack:check": "yarn build && node ../scripts/dist/test-tooling-package.js"
  },
  "devDependencies": {
    "@types/node": "20.19.30",
    "ajv": "8.20.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
