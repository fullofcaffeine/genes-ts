-lib genes-ts
--macro haxe.macro.Compiler.nullSafety("todo.shared", Loose, true)
--macro haxe.macro.Compiler.nullSafety("todo.extern", Loose, true)
--macro haxe.macro.Compiler.nullSafety("todo.web", Loose, true)
--macro haxe.macro.Compiler.nullSafety("todo.server", Loose, true)
-lib hxnodejs

-cp examples/todoapp/e2e/src
--main todo.e2e.Main

# Emit TypeScript via genes-ts (still uses -js because we compile on the JS platform)
-js examples/todoapp/e2e/src-gen/tests/spec.ts
-D genes.ts

-dce full
