{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": [],
    "declaration": true,
    "sourceMap": true,
    "jsx": "preserve",
    "rootDir": "./out/tsx/src-gen",
    "outDir": "./out/tsx/dist",
    "verbatimModuleSyntax": true,
    "skipLibCheck": false
  },
  "include": ["out/tsx/src-gen/**/*.tsx"]
}
