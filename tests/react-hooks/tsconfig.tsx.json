{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": ["out/tsx/src-gen/**/*.ts", "out/tsx/src-gen/**/*.tsx"]
}
