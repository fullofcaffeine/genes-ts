{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "types": [],
    "rootDir": "./out/ts-none",
    "outDir": "./out/ts-dist",
    "verbatimModuleSyntax": true,
    "skipLibCheck": false
  },
  "include": ["out/ts-none/**/*.ts"]
}
