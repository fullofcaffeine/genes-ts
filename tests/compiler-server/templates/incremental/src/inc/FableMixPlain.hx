package inc;

/**
 * Like `inc.FableMix`, without metadata that a macro changes: the control
 * row of must fix 1 of the review of genes-ts #249. The first use of
 * `thrice` as a value adds a wrapper class to this module, and the request
 * must stay incremental.
 */
extern class FableMixPlain {
  public static inline function thrice(value: Int): Int {
    return value * 3;
  }
}
